  {
   "id": 7,
   "type": "table",
   "title": "Части кластера (Flux)",
   "description": "Каждая строка — часть кластера, которую Flux применяет отдельно. «Да» — применено и здорово; «идёт» — применяется; «нет» — ошибка, причина в колонке «Почему» (подробно — в Telegram и «Логи», namespace flux-system). Клик по версии — коммит в GitHub (у Helm-чартов это версия чарта, без ссылки).",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "max by (exported_namespace, kind, name, ready, reason, short, sha, repo) (label_replace(label_replace(label_replace(label_replace(flux_resource_info{kind=~\"Kustomization|HelmRelease\"}, \"repo\", \"infra\", \"source_name\", \"flux-system|infra-dev\"), \"repo\", \"$1\", \"source_name\", \"(auth|mail)\"), \"short\", \"$1\", \"revision\", \"(?:.*sha1:)?([0-9a-f]{7}|[^@]*)[0-9a-f]*$\"), \"sha\", \"$1\", \"revision\", \".*sha1:([0-9a-f]{40}).*\"))",
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "cellOptions": {
       "type": "color-text"
      },
      "align": "left"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "True": {
         "text": "да",
         "color": "green",
         "index": 0
        },
        "False": {
         "text": "нет",
         "color": "red",
         "index": 1
        },
        "Unknown": {
         "text": "идёт",
         "color": "blue",
         "index": 2
        }
       }
      }
     ]
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Версия"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Открыть коммит в GitHub",
          "url": "https://github.com/bulbashenko-com/${__data.fields.repo}/commit/${__data.fields.sha}",
          "targetBlank": true
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "repo"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "sha"
      },
      "properties": [
       {
        "id": "custom.hidden",
        "value": true
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "Где",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "exported_namespace": true,
       "name": true,
       "kind": true,
       "ready": true,
       "reason": true,
       "short": true,
       "repo": true,
       "sha": true
      },
      "indexByName": {
       "exported_namespace": 0,
       "name": 1,
       "kind": 2,
       "ready": 3,
       "reason": 4,
       "short": 5,
       "repo": 6,
       "sha": 7
      },
      "renameByName": {
       "exported_namespace": "Где",
       "name": "Что",
       "kind": "Тип",
       "ready": "Готово",
       "reason": "Почему",
       "short": "Версия",
       "repo": "repo",
       "sha": "sha"
      }
     }
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 10
   }
