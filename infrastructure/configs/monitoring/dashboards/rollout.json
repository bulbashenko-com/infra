  {
   "id": 3,
   "type": "stat",
   "title": "Состояние",
   "description": "Готово — всё из git применено и все поды новые. Идёт — Flux применяет или поды заменяются (нормально 2–5 минут после релиза или пина на staging). Ошибка — что-то не применилось: таблица ниже и Telegram.",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "((count(flux_resource_info{kind=~\"Kustomization|HelmRelease\", ready=\"False\", suspended!=\"True\", reason!=\"DependencyNotReady\"}) or vector(0)) > bool 0) * 2 + ((count(flux_resource_info{kind=~\"Kustomization|HelmRelease\", ready=\"False\", suspended!=\"True\", reason!=\"DependencyNotReady\"}) or vector(0)) == bool 0) * (((count(flux_resource_info{kind=\"Kustomization\", exported_namespace=\"flux-system\", source_name=\"flux-system\"} unless on (revision) flux_resource_info{kind=\"GitRepository\", exported_namespace=\"flux-system\", name=\"flux-system\"}) or vector(0)) + (count(flux_resource_info{kind=~\"Kustomization|HelmRelease\", ready=\"Unknown\"}) or vector(0)) + (count(flux_resource_info{kind=~\"Kustomization|HelmRelease\", reason=\"DependencyNotReady\"}) or vector(0)) + (count(kube_deployment_status_replicas_updated < kube_deployment_spec_replicas) or vector(0)) + (count(kube_statefulset_status_replicas_updated < kube_statefulset_replicas) or vector(0))) > bool 0)",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "blue",
        "value": 1
       },
       {
        "color": "red",
        "value": 2
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Готово",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "Идёт",
         "color": "blue",
         "index": 1
        },
        "2": {
         "text": "Ошибка",
         "color": "red",
         "index": 2
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 8,
    "h": 6
   }
