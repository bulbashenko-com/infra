    "uid": "VictoriaMetrics"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "clamp_max(min by (namespace, deployment) (kube_deployment_status_replicas_updated{namespace=~\"site|site-staging|auth|auth-staging|mail|nextcloud|headscale\"}) / max by (namespace, deployment) (kube_deployment_spec_replicas{namespace=~\"site|site-staging|auth|auth-staging|mail|nextcloud|headscale\"} > 0), 1)",
     "legendFormat": "{{namespace}}/{{deployment}}",
     "instant": true
