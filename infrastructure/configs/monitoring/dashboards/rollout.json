   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum by (name) (rate(gotk_reconcile_duration_seconds_sum{kind=\"Kustomization\"}[5m])) / sum by (name) (rate(gotk_reconcile_duration_seconds_count{kind=\"Kustomization\"}[5m])) > 0.5",
