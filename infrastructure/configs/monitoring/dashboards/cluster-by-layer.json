{
 "uid": "bulbashenko-layers",
 "title": "Cluster by layer",
 "tags": [
  "bulbashenko"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "editable": true,
 "description": "Resource use and health grouped by the ownership labels bulbashenko.com/layer and bulbashenko.com/app (infra README: Labels).",
 "templating": {
  "list": [
   {
    "name": "layer",
    "label": "Layer",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "VictoriaMetrics"
    },
    "query": {
     "query": "label_values(kube_namespace_labels, label_bulbashenko_com_layer)",
     "refId": "q"
    },
    "includeAll": true,
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "allValue": ".*",
    "refresh": 2
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Pods not ready",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum(kube_pod_status_ready{condition=\"false\"} * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"})) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Container restarts (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum(increase(kube_pod_container_status_restarts_total[1h]) * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"})) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Targets down",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "count(up == 0) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Firing alerts",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "count(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\",alertname!=\"InfoInhibitor\"}) or vector(0)",
     "instant": true
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "CPU by layer",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "cores",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum by (label_bulbashenko_com_layer) (rate(container_cpu_usage_seconds_total{container!=\"\",pod!=\"\"}[5m]) * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"}))",
     "legendFormat": "{{label_bulbashenko_com_layer}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Memory by layer",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum by (label_bulbashenko_com_layer) (container_memory_working_set_bytes{container!=\"\",pod!=\"\"} * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"}))",
     "legendFormat": "{{label_bulbashenko_com_layer}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU by app",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "cores",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum by (label_bulbashenko_com_app) (rate(container_cpu_usage_seconds_total{container!=\"\",pod!=\"\"}[5m]) * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"}))",
     "legendFormat": "{{label_bulbashenko_com_app}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Memory by app",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 20
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum by (label_bulbashenko_com_app) (container_memory_working_set_bytes{container!=\"\",pod!=\"\"} * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"}))",
     "legendFormat": "{{label_bulbashenko_com_app}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Restarts by app (1h)",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "sum by (label_bulbashenko_com_app) (increase(kube_pod_container_status_restarts_total[1h]) * on (namespace) group_left (label_bulbashenko_com_layer, label_bulbashenko_com_app) max by (namespace, label_bulbashenko_com_layer, label_bulbashenko_com_app) (kube_namespace_labels{label_bulbashenko_com_layer=~\"$layer\"})) > 0",
     "legendFormat": "{{label_bulbashenko_com_app}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Node memory used",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "stacking": {
       "mode": "none"
      },
      "fillOpacity": 0
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * on (instance) group_left (nodename) node_uname_info",
     "legendFormat": "{{nodename}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "table",
   "title": "Scrape targets",
   "datasource": {
    "type": "prometheus",
    "uid": "VictoriaMetrics"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "up",
         "color": "green"
        }
       }
      }
     ],
     "custom": {
      "cellOptions": {
       "type": "color-text"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "Value",
      "desc": false
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "min by (job, namespace) (up)",
     "instant": true,
     "format": "table"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      }
     }
    }
   ]
  }
 ]
}