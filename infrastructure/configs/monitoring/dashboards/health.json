      "type": "prometheus",
      "uid": "VictoriaMetrics"
     },
     "expr": "min(clamp_max((kube_deployment_status_replicas_available{namespace=\"site\"} / (kube_deployment_spec_replicas{namespace=\"site\"} > 0)) or (kube_statefulset_status_replicas_available{namespace=\"site\"} / (kube_statefulset_replicas{namespace=\"site\"} > 0)), 1)) >= bool 1",
